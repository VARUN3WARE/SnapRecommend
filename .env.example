# Phase Configuration
PHASE_MODE=phase1  # phase1 or phase2
USE_RANKER=false
USER_ENCODER_MODE=legacy  # legacy or transformer

# Model Configuration
HYBRID_IMAGE_WEIGHT=0.5
HYBRID_TEXT_WEIGHT=0.5

# Training Configuration
SEED=42
TRAIN_SPLIT=0.8
NEGATIVE_SAMPLES=4
TWO_TOWER_HIDDEN_DIM=512
RANKER_HIDDEN_DIMS=(256,64)
RANKER_DROPOUT=0.2
RANKER_FEATURE_DIM=1538

# FAISS Configuration
FAISS_USE_GPU=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
MAX_INPUT_IMAGE_PX=512

# Database Configuration (optional, for production)
DATABASE_URL=sqlite:///./data/snaprecommend.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# Performance Settings
FINAL_TOP_N=100  # Number of candidates before reranking

# Optional: GPU settings
CUDA_VISIBLE_DEVICES=0
